            "exec": [
              "pm.test(\"Expected status 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"user_id\", pm.response.json().user_id); }",
              "pm.test(\"User created\", function () { pm.expect(pm.response.json().name).to.eql(\"John Doe\"); });"
            ]
